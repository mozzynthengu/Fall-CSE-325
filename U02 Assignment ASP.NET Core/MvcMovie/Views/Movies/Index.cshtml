
@model IEnumerable<MvcMovie.Models.Movie>

@{
    ViewData["Title"] = "My Movies";
}

<h1>My Movies</h1>

<form asp-controller="Movies" asp-action="Index" method="get" class="movie-search">
    <div class="form-group mb-3">
        <label for="searchString">Search title or genre</label>
        <input type="text"
               id="searchString"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Enter a title or genre" />
    </div>

    <div class="form-group mb-3">
        <label for="selectedYear">Release year or newer</label>
        <select id="selectedYear" name="selectedYear" class="form-select">
            <option value="">All years</option>
            @foreach (int year in (List<int>)ViewBag.Years)
            {
                if (ViewData["SelectedYear"] is int selected
                    && selected == year)
                {
                    <option value="@year" selected>@year and newer</option>
                }
                else
                {
                    <option value="@year">@year and newer</option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Clear</a>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Add a Movie</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Date</th>
            <th>Genre</th>
            <th>Rating</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.ReleaseDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Genre)</td>
                <td>@Html.DisplayFor(modelItem => item.Rating)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
